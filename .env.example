# ══════════════════════════════════════════════════════════════
#  Enterprise PII Gateway — Environment Configuration Template
#  Copy this to .env and fill in your values
#  NEVER commit .env to Git
# ══════════════════════════════════════════════════════════════

# TLS Mode: corp_ca | dns | sidecar | scrub_api
TLS_MODE=corp_ca

# Redis (rate limiting + policy cache)
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@localhost:6379/0

# PostgreSQL (audit trail)
DATABASE_URL=postgresql://pii_user:YOUR_DB_PASSWORD@localhost:5432/pii_audit

# Certificate paths
CORP_CA_BUNDLE=./certs/corp_ca_bundle.crt
MTLS_CERT=./certs/gateway.crt
MTLS_KEY=./certs/gateway.key
MTLS_CLIENT_CA=./certs/sidecar-ca.crt

# Logging
LOG_LEVEL=INFO
